{
  "name": "lfnawa-days",
  "version": "2.0.0",
  "private": true,
  "description": "Lfnawa Days — offline-first life journal (Today, My Day, Calendar, Memories, Goals, Learning, Money, Health & Habits, Mind, Insights) with Lfenwa Trades (the original trading journal) preserved as an embedded, byte-identical section. Next.js + TypeScript web app, plus Electron desktop and Capacitor Android shells around the same static export.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-export.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "setup:desktop": "npm install --prefix desktop",
    "setup:mobile": "npm install --prefix mobile",
    "start:desktop": "npm run start --prefix desktop",
    "build:linux": "npm run dist:linux --prefix desktop",
    "build:win": "npm run dist:win --prefix desktop",
    "build:desktop:all": "npm run dist:all --prefix desktop",
    "sync:android": "npm run sync --prefix mobile",
    "open:android": "npm run open:android --prefix mobile",
    "build:android:debug": "npm run build:debug --prefix mobile",
    "build:android:release": "npm run build:release --prefix mobile",
    "build:legacy-web": "npm install --prefix legacy-web && node legacy-web/build.js"
  },
  "dependencies": {
    "next": "^15.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.3",
    "typescript": "^5.7.2"
  }
}
